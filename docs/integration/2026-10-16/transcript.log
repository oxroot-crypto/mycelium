s full paths to all matching items. Great for finding files when you don't know their exact location. Only searches within allowed directories.","name":"search_files","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"excludePatterns":{"default":[],"items":{"type":"string"},"type":"array"},"path":{"type":"string"},"pattern":{"type":"string"}},"required":["path","pattern"],"type":"object"}},"type":"function"},{"function":{"description":"Create a new file or completely overwrite an existing file with new content. Use with caution as it will overwrite existing files without warning. Handles text content with proper encoding. Only works within allowed directories.","name":"write_file","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"content":{"type":"string"},"path":{"type":"string"}},"required":["path","content"],"type":"object"}},"type":"function"}]}
