# mycelium 本地环境变量示例（复制为 .env 并填入真实值；.env 已被 gitignore）
#
# DeepSeek 联调示例（crates/mycelium-provider-openai/examples/deepseek.rs）
DEEPSEEK_API_KEY=
# 可选：网关地址与模型
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-flash

# OpenRouter 联调示例（live_integration 场景 7：文本向量化；DeepSeek 无 embedding 端点）
# OPENROUTER_API_KEY=
# 可选：网关地址与向量化模型
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
